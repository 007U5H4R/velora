# Copy to .env.local and fill from your Supabase project (Settings -> API).
# When these are BLANK, the app runs on built-in mock data (demo mode).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Service-role key — used ONLY by the seed script (supabase/seed.ts), never in the app bundle. Do not commit a filled .env.local.
SUPABASE_SERVICE_ROLE_KEY=
